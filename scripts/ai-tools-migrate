#!/usr/bin/env bash
set -euo pipefail

channel="${AI_TOOLS_CHANNEL:-pinned}"

remove_managed_link() {
  local link="$1"
  shift
  [[ -L "$link" ]] || return 0

  local target
  target="$(/usr/bin/readlink "$link")"
  for managed_target in "$@"; do
    # Patterns deliberately include a wildcard after a known managed prefix.
    # shellcheck disable=SC2254
    case "$target" in
      $managed_target)
        /bin/rm -f "$link"
        return 0
        ;;
    esac
  done
}

if [[ "$channel" != latest ]]; then
  # Remove only launchers created by the installers previously managed here.
  # Their state/config directories remain untouched.
  remove_managed_link "$HOME/.local/bin/claude" "$HOME/.local/share/claude/versions/*"
  remove_managed_link "$HOME/.local/bin/codex" "$HOME/.codex/packages/standalone/*"
  remove_managed_link "$HOME/.local/bin/opencode" "$HOME/.opencode/bin/opencode"
  remove_managed_link "$HOME/.local/bin/opencode1" "$HOME/.opencode/bin/opencode"
  remove_managed_link "$HOME/.local/bin/executor" \
    "../lib/node_modules/executor/bin/executor" \
    "$HOME/.local/lib/node_modules/executor/*"
fi

# These packages were previously declared by this configuration. Homebrew's
# global cleanup remains disabled, so migrate only these exact known entries.
brew_bin="${AI_TOOLS_BREW_BIN:-}"
if [[ -z "$brew_bin" ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    brew_bin=/opt/homebrew/bin/brew
  elif command -v brew >/dev/null 2>&1; then
    brew_bin="$(command -v brew)"
  fi
fi
if [[ -n "$brew_bin" ]]; then
  for old_cask in claude-code@latest codex; do
    if "$brew_bin" list --cask "$old_cask" >/dev/null 2>&1; then
      "$brew_bin" uninstall --cask --force "$old_cask" || \
        echo "warning: could not remove legacy Homebrew cask $old_cask" >&2
    fi
  done
  old_formulas=(opencode)
  if [[ "$channel" != latest ]]; then
    old_formulas+=(secretspec)
  fi
  for old_formula in "${old_formulas[@]}"; do
    if "$brew_bin" list --formula "$old_formula" >/dev/null 2>&1; then
      "$brew_bin" uninstall --formula --force "$old_formula" || \
        echo "warning: could not remove legacy Homebrew formula $old_formula" >&2
    fi
  done
fi
