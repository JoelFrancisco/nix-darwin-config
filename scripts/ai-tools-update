#!/usr/bin/env bash
set -euo pipefail

export PATH="/opt/homebrew/bin:$HOME/.local/bin:$HOME/.local/share/npm/bin:/usr/bin:/bin:$PATH"
mkdir -p "$HOME/.local" "$HOME/.local/state/ai-tools"

brew update || true
brew upgrade --formula ai-jail cliproxyapi herdr hermes-agent secretspec cirruslabs/cli/tart || true
brew upgrade --cask --greedy claude claude-code@latest codex codex-app || true

npm install --global --prefix "$HOME/.local" \
  opencode-ai@latest \
  @opencode-ai/cli@next \
  executor@latest

if [[ -x "$HOME/.local/bin/opencode" ]]; then
  ln -sfn "$HOME/.local/bin/opencode" "$HOME/.local/bin/opencode1"
fi

# The v2 prerelease currently publishes its executable as `lildax`; retain the
# stable name used by aliases and T3 Code as upstream prereleases evolve.
if [[ -x "$HOME/.local/bin/lildax" ]]; then
  ln -sfn "$HOME/.local/bin/lildax" "$HOME/.local/bin/opencode2"
fi

command -v claude >/dev/null 2>&1 && claude update || true
command -v hermes >/dev/null 2>&1 && hermes update --yes || true
"$HOME/.local/bin/ai-skills-update" || true
"$HOME/.local/bin/t3-nightly-update" || true
