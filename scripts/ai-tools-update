#!/usr/bin/env bash
set -euo pipefail

current_user="$(id -un)"
export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:/etc/profiles/per-user/$current_user/bin:/run/current-system/sw/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
export CODEX_NON_INTERACTIVE=1
mkdir -p "$HOME/.local" "$HOME/.local/state/ai-tools"

channel="${AI_TOOLS_CHANNEL:-pinned}"
mutable_tools=" ${AI_TOOLS_MUTABLE_TOOLS:-opencode2 hermes cliproxyapi} "

is_mutable() {
  [[ "$mutable_tools" == *" $1 "* ]]
}

lock_file="$HOME/.local/state/ai-tools/update.lock"
if ! /usr/bin/shlock -f "$lock_file" -p "$$"; then
  echo "ai-tools-update: another update is already running"
  exit 0
fi

installer_dir=""
cleanup() {
  [[ -z "$installer_dir" ]] || rm -rf "$installer_dir"
  rm -f "$lock_file"
}
trap cleanup EXIT

installer_dir="$(mktemp -d)"

run_official_installer() {
  local url="$1"
  local name="$2"
  shift 2
  curl -fsSL "$url" -o "$installer_dir/$name"
  /bin/bash "$installer_dir/$name" "$@"
}

if [[ "$channel" = latest ]]; then
  # The opt-in mutable channel preserves the former first-party installer path.
  run_official_installer https://claude.ai/install.sh claude-install latest
  run_official_installer https://chatgpt.com/codex/install.sh codex-install
  run_official_installer https://opencode.ai/install opencode-install --no-modify-path
  ln -sfn "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode"
  ln -sfn "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode1"
  npm install --global --prefix "$HOME/.local" executor@latest
fi

if is_mutable opencode2; then
  run_official_installer https://opencode.ai/v2/install opencode2-install --no-modify-path
  # OpenCode 2 defaults to 49374, which is reserved for the ai-memory MCP server.
  "$HOME/.opencode/bin/opencode2" service set port 49375
  ln -sfn "$HOME/.opencode/bin/opencode2" "$HOME/.local/bin/opencode2"
fi

# Slower package-manager refreshes run after the latency-sensitive agent CLIs.
brew update || true
brew_formulas=(ai-jail herdr cirruslabs/cli/tart)
is_mutable cliproxyapi && brew_formulas+=(cliproxyapi)
is_mutable hermes && brew_formulas+=(hermes-agent)
if [[ "$channel" = latest ]]; then
  if brew list --formula secretspec >/dev/null 2>&1; then
    brew_formulas+=(secretspec)
  else
    brew install --formula secretspec || true
  fi
fi
brew upgrade --formula "${brew_formulas[@]}" || true
if is_mutable hermes && command -v hermes >/dev/null 2>&1; then
  hermes update --yes || true
fi
"$HOME/.local/bin/ai-skills-update" || true
"$HOME/.local/bin/t3-nightly-update" || true
