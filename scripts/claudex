#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${CLAUDEX_PROXY_TOKEN:-}" ]]; then
  exec secretspec run \
    --file "$HOME/.config/nix-darwin/secretspec.toml" \
    --profile personal \
    --scope claudex \
    -- "$0" "$@"
fi

proxy_url="${CLAUDEX_PROXY_URL:-http://127.0.0.1:8317}"
proxy_token="$CLAUDEX_PROXY_TOKEN"
model="${CLAUDEX_MODEL:-gpt-5.6-sol}"
max_context_tokens="${CLAUDEX_CONTEXT_WINDOW:-372000}"
auto_compact_window="${CLAUDEX_AUTO_COMPACT_WINDOW:-330000}"
claude_bin="${CLAUDE_BIN:-claude}"
state_dir="$HOME/.local/state/cli-proxy-api"
runtime_config="$state_dir/config.json"
template_config="$HOME/.config/cli-proxy-api/config.template.json"
pid_file="$state_dir/daemon.pid"
lock_dir="$state_dir/lock"

mkdir -p "$state_dir" "$HOME/.config/cli-proxy-api/auth"
umask 077
lock_acquired=0
for _ in {1..50}; do
  if mkdir "$lock_dir" 2>/dev/null; then
    lock_acquired=1
    break
  fi
  sleep 0.1
done
if [[ "$lock_acquired" -ne 1 ]]; then
  echo "claudex: timed out waiting for CLIProxyAPI lock" >&2
  exit 1
fi

config_tmp="$(mktemp "$state_dir/config.XXXXXX")"
trap 'rm -f "$config_tmp"; rmdir "$lock_dir" 2>/dev/null || true' EXIT
jq \
  --arg auth_dir "$HOME/.config/cli-proxy-api/auth" \
  '."auth-dir" = $auth_dir | ."api-keys" = [env.CLAUDEX_PROXY_TOKEN]' \
  "$template_config" >"$config_tmp"
chmod 600 "$config_tmp"
mv -f "$config_tmp" "$runtime_config"

if ! curl -fsS --max-time 1 -H "Authorization: Bearer ${proxy_token}" \
  "${proxy_url}/v1/models" >/dev/null 2>&1; then
  if [[ -s "$pid_file" ]]; then
    existing_pid="$(<"$pid_file")"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" 2>/dev/null; then
      kill "$existing_pid"
      for _ in {1..20}; do
        kill -0 "$existing_pid" 2>/dev/null || break
        sleep 0.1
      done
    fi
  fi
  nohup cliproxyapi -config "$runtime_config" \
    >>"$state_dir/daemon.log" 2>&1 &
  proxy_pid=$!
  printf '%s\n' "$proxy_pid" >"$pid_file"
  disown "$proxy_pid" 2>/dev/null || true
  for _ in {1..20}; do
    curl -fsS --max-time 1 -H "Authorization: Bearer ${proxy_token}" \
      "${proxy_url}/v1/models" >/dev/null 2>&1 && break
    sleep 0.1
  done
fi

rmdir "$lock_dir"
trap - EXIT

export ANTHROPIC_BASE_URL="${proxy_url}"
export ANTHROPIC_AUTH_TOKEN="${proxy_token}"
unset ANTHROPIC_API_KEY || true
unset CLAUDEX_PROXY_TOKEN
export ANTHROPIC_MODEL="${model}"
export ANTHROPIC_CUSTOM_MODEL_OPTION="${model}"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="GPT 5.6 via CLIProxyAPI"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${model}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${model}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${model}"
export CLAUDE_CODE_SUBAGENT_MODEL="${model}"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${max_context_tokens}"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${auto_compact_window}"

exec "$claude_bin" --model "${model}" "$@"
