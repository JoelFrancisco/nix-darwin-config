#!/usr/bin/env bash
set -euo pipefail

export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/bin:/bin:$PATH"
# These are the only allowed skill sources. No private Betha repositories are
# copied or queried by this configuration.
npx --yes skills add mattpocock/skills --all --global --yes
for skill in \
  codex-computer-use \
  design-better-interfaces \
  design-with-taste \
  goal-supervisor \
  publish-and-sync-skills; do
  npx --yes skills add JoelFrancisco/skills --skill "$skill" --global --yes
done
