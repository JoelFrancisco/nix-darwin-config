#!/usr/bin/env bash
set -euo pipefail

# Command-Space (key code 49) is Raycast's global hotkey on this machine.
/usr/bin/defaults write com.raycast.macos raycastGlobalHotkey -string "Command-49"
/usr/bin/defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 \
  '<dict><key>enabled</key><false/></dict>'

# LaunchServices has no universal "default terminal" slot. These cover the
# relevant document types and make Ghostty the terminal opened by scripts.
if [[ -x /opt/homebrew/bin/duti ]]; then
  /opt/homebrew/bin/duti -s com.mitchellh.ghostty public.unix-executable all || true
  /opt/homebrew/bin/duti -s com.mitchellh.ghostty public.shell-script all || true
  /opt/homebrew/bin/duti -s com.mitchellh.ghostty com.apple.terminal.shell-script all || true
fi
